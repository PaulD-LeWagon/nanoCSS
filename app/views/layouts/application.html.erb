<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "nanoCSS | The Stateless Framework Generator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="Generate a bespoke, dependency-free CSS framework tailored exactly to your design tokens.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# 1. App chrome stylesheet (layout, nav, dark theme shell) %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%# 2. Compiled nanoCSS framework is now imported via application.css
        Preview pane uses a separate stylesheet link. %>

    <%= javascript_importmap_tags %>
    
    <%# 3. Dynamic dogfooded framework injection %>
    <% if @nanocss_css.present? %>
      <style id="nanocss-framework-style">
        <%= @nanocss_css.html_safe %>
      </style>
    <% end %>
  </head>

  <body>
    <div class="app-container">
      <nav class="top-nav">
        <%= link_to "nanoCSS", root_path, class: "nav-brand" %>
        <div class="nav-links">
          <%= link_to "Component Catalogue", components_path, class: "btn btn-outline" %>
          <%= link_to "Configure →", configure_path, class: "btn btn-outline" %>
        </div>
      </nav>

      <main style="flex: 1; display: flex; flex-direction: column;">
        <%= yield %>
      </main>
    </div>

    <%# UC-022: Floating Theme Switcher — suppressed on /configure (UC-037 AC2) to avoid colliding with the config form %>
    <% unless request.path == configure_path %>
    <div class="<%= @prefix || "nanocss" %>-theme-switcher" data-controller="theme">
      <details>
        <summary>
          <div class="switcher-icon">
            <%= nano_icon("settings", size: 20) %>
            <span>Theme Controls</span>
          </div>
        </summary>
        <div class="switcher-content">
          <h4>Appearance</h4>
          <div class="theme-options">
            <button class="<%= @prefix || "nanocss" %>-btn-outline" data-action="click->theme#toggleDark" style="display: flex; align-items: center; gap: 0.5rem; justify-content: center; width: 100%;">
              <%= nano_icon("moon", size: 16) %>
              <span>Toggle Dark Mode</span>
            </button>
          </div>
          
          <h4>Presets</h4>
          <div class="theme-options">
            <% [["Corporate", "eyJwcmVmaXgiOiJuYW5vY3NzIiwiY29sb3VyX3ByaW1hcnkiOiIjMGI1ZWRmIiwiY29sb3VyX3NlY29uZGFyeSI6IiM0NzU1NjkiLCJjb2xvdXJfdGVydGlhcnkiOiIjOTRhM2I4IiwicmFkaXVzX2Jhc2UiOiIwLjVyZW0iLCJzcGFjaW5nX2Jhc2UiOiIxcmVtIn0="], ["Playful", "eyJwcmVmaXgiOiJuYW5vY3NzIiwiY29sb3VyX3ByaW1hcnkiOiIjZmM2YTljIiwiY29sb3VyX3NlY29uZGFyeSI6IiNmZGU2OGEiLCJjb2xvdXJfdGVydGlhcnkiOiIjODBlN2ZmIiwicmFkaXVzX2Jhc2UiOiIxLjVyZW0iLCJzcGFjaW5nX2Jhc2UiOiIxLjJyZW0ifQ=="], ["Minimalist", "eyJwcmVmaXgiOiJuYW5vY3NzIiwiY29sb3VyX3ByaW1hcnkiOiIjMTExODI3IiwiY29sb3VyX3NlY29uZGFyeSI6IiM2YjcyODAiLCJjb2xvdXJfdGVydGlhcnkiOiIjZTVlN2ViIiwicmFkaXVzX2Jhc2UiOiIwcmVtIiwic3BhY2luZ19iYXNlIjoiMC43NXJlbSJ9"]].each do |name, params| %>
              <button class="<%= @prefix || "nanocss" %>-btn-outline" data-action="click->theme#applyPreset" data-theme-params="<%= params %>" style="width: 100%; text-align: left; padding: 0.5rem;">
                <%= name %>
              </button>
            <% end %>
          </div>
        </div>
      </details>
    </div>
    <% end %>
  </body>
</html>
