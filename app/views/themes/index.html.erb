<%# Landing Page — SCR-001
    Traces: design/BACKLOG.md UC-001, design/UI_COMPONENTS.md §4 %>

<%# ── Hero ──────────────────────────────────────────────────────────────── %>
<section class="hero-section">
  <h1>Stateless Framework<br>Generation</h1>
  <p>Zero dependencies. Zero tracking. Configure your brand tokens, preview the result, and download a custom-built CSS framework — instantly.</p>
  <div class="hero-cta">
    <%= link_to "Customise Your Theme →", configure_path, class: "btn-hero-primary" %>
    <a href="#presets" class="btn-hero-outline">Explore Presets</a>
  </div>

  <%# Feature pills %>
  <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-top: 3rem;">
    <% [["⚡ In-memory Dart Sass", nil], ["🎨 18 Components", nil], ["📦 Zero Dependencies", nil], ["♿ WCAG 2.1 AA", nil]].each do |label, _| %>
      <span style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 2rem; padding: 0.375rem 1rem; font-size: 0.8125rem; color: #94a3b8;"><%= label %></span>
    <% end %>
  </div>
</section>

<%# ── Preset Themes ──────────────────────────────────────────────────────── %>
<section class="presets-section" id="presets">
  <%# The compiled nanoCSS style — replaced by Turbo Stream on Quick Apply %>
  <div id="nanocss-preview-style"></div>

  <h2>One-Click Preset Themes</h2>
  <div class="preset-grid">
    <% @presets.each do |preset| %>
      <article class="preset-card">
        <div class="preset-card-swatch" style="background: linear-gradient(135deg, <%= preset[:primary] %>, <%= preset[:tertiary] %>);"></div>
        <div class="preset-card-body">
          <h3><%= preset[:name] %></h3>
          <p>A curated starting point — primary <code style="font-size: 0.75rem;"><%= preset[:primary] %></code>, secondary <code style="font-size: 0.75rem;"><%= preset[:secondary] %></code>.</p>
          <div class="preset-card-actions">
            <%= button_to "Quick Apply",
                  theme_preview_path,
                  params: { theme_configuration: { primary: preset[:primary], secondary: preset[:secondary], tertiary: preset[:tertiary] } },
                  form: { data: { turbo_stream: true } },
                  class: "btn-preset-primary" %>
            <%= link_to "Edit →",
                  configure_path(theme: ThemeConfiguration.new(primary: preset[:primary], secondary: preset[:secondary], tertiary: preset[:tertiary]).to_base64),
                  class: "btn-preset-outline" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>

<%# ── Live Preview ────────────────────────────────────────────────────────── %>
<section class="live-preview-section" id="live-preview">
  <div class="inner">
    <h2>Live Preview</h2>
    <p class="subtitle">Click <strong style="color: #a855f7;">Quick Apply</strong> above and watch every element below change instantly — no reload.</p>

    <div class="preview-window">
      <%# Fake browser chrome bar %>
      <div class="preview-window-bar">
        <span class="preview-window-dot" style="background:#f87171;"></span>
        <span class="preview-window-dot" style="background:#fb923c;"></span>
        <span class="preview-window-dot" style="background:#4ade80;"></span>
        <span class="preview-window-url">your-project.com — styled by nanocss</span>
      </div>

      <%# Preview content — ALL styled by nanocss custom properties %>
      <div class="preview-window-content">

        <%# Hero component %>
        <section class="nanocss-hero" style="min-height: auto; padding: 2rem 1.5rem; margin-bottom: 1.5rem;">
          <hgroup style="text-align: center;">
            <h1 style="font-family: var(--nanocss-font-heading); font-size: var(--nanocss-text-xl); margin-bottom: 0.25rem;">Your Site Headline</h1>
            <p style="font-family: var(--nanocss-font-subtitle); color: var(--nanocss-neutral-500); margin: 0;">Styled entirely by your compiled nanoCSS framework</p>
          </hgroup>
          <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.25rem; flex-wrap: wrap;">
            <button class="nanocss-btn-primary">Get Started</button>
            <button class="nanocss-btn-outline">Learn More</button>
          </div>
        </section>

        <%# Colour brand swatches %>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 1.5rem;">
          <div style="background: var(--nanocss-primary); height: 3rem; border-radius: var(--nanocss-radius-md, 0.25rem); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem; font-weight: 600;">Primary</div>
          <div style="background: var(--nanocss-secondary); height: 3rem; border-radius: var(--nanocss-radius-md, 0.25rem); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem; font-weight: 600;">Secondary</div>
          <div style="background: var(--nanocss-tertiary); height: 3rem; border-radius: var(--nanocss-radius-md, 0.25rem); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem; font-weight: 600;">Tertiary</div>
        </div>

        <%# Nav Component %>
        <nav class="nanocss-nav" style="margin-bottom: 1.5rem; border-radius: var(--nanocss-radius-md, 0.25rem);">
          <strong>BrandLogo</strong>
          <ul class="nav-menu">
            <li><a href="#">Home</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
          </ul>
        </nav>

        <%# Cards with Badges — showcasing card variants %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
          <article class="nanocss-card-primary">
            <header>
              Primary Card
              <span class="nanocss-badge" style="margin-left: 0.5rem; background: rgba(255,255,255,0.25); color: #fff;">New</span>
            </header>
            <div class="card-body">
              <p style="font-size: 0.875rem; margin: 0;">Header uses your <code>--nanocss-primary</code> brand colour.</p>
            </div>
            <footer>
              <button class="nanocss-btn-primary" style="font-size: 0.8125rem; padding: 0.375rem 0.875rem;">View →</button>
            </footer>
          </article>
          <article class="nanocss-card-secondary">
            <header>
              Secondary Card
              <span class="nanocss-badge warning" style="margin-left: 0.5rem;">Beta</span>
            </header>
            <div class="card-body">
              <p style="font-size: 0.875rem; margin: 0;">Header uses your <code>--nanocss-secondary</code> colour.</p>
            </div>
            <footer>
              <button class="nanocss-btn-secondary" style="font-size: 0.8125rem; padding: 0.375rem 0.875rem;">Details</button>
            </footer>
          </article>
          <article class="nanocss-card-neutral">
            <header>Neutral Card</header>
            <div class="card-body">
              <p style="font-size: 0.875rem; margin: 0;">Muted header using the neutral shade scale — great for secondary content.</p>
            </div>
            <footer>Info only</footer>
          </article>
        </div>

        <%# Tabs %>
        <div class="nanocss-tabs" style="margin-bottom: 1.5rem;">
          <input type="radio" id="prev-tab1" name="preview_tabs" checked />
          <label for="prev-tab1">Typography</label>
          <div class="panel" id="panel1">
            <blockquote>The blockquote border uses the <strong>primary</strong> brand colour — watch it change.</blockquote>
            <p style="font-family: var(--nanocss-font-body);">Body copy in <code>--nanocss-font-body</code>. Heading in <code>--nanocss-font-heading</code>.</p>
          </div>
          <input type="radio" id="prev-tab2" name="preview_tabs" />
          <label for="prev-tab2">Forms</label>
          <div class="panel" id="panel2">
            <label for="preview-name">Your name</label>
            <input type="text" id="preview-name" placeholder="e.g. Jane Smith" style="margin-bottom: 0.75rem;">
            <label for="preview-select">Tier</label>
            <select id="preview-select">
              <option>Nano (base styles only)</option>
              <option>Standard (+ utilities)</option>
              <option>Full (+ components)</option>
            </select>
          </div>
          <input type="radio" id="prev-tab3" name="preview_tabs" />
          <label for="prev-tab3">Feedback</label>
          <div class="panel" id="panel3">
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
              <span class="nanocss-badge success">Online</span>
              <span class="nanocss-badge warning">Pending</span>
              <span class="nanocss-badge danger">Error</span>
              <span class="nanocss-badge">Draft</span>
            </div>
            <progress value="65" max="100" style="margin-bottom: 0.75rem;">65%</progress>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <span class="nanocss-loader"></span>
              <span style="font-size: 0.875rem; color: var(--nanocss-neutral-500);">Processing...</span>
            </div>
          </div>
        </div>

        <%# Accordion + Tooltip %>
        <details style="margin-bottom: 1rem;">
          <summary>Accordion — click to expand</summary>
          <p style="margin-top: 0.75rem; font-size: 0.875rem;">Zero JavaScript — native <code>&lt;details&gt;</code> styled by the base layer. The chevron, border, and padding all come from your config.</p>
        </details>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
          <span tabindex="0" data-tooltip="No JS tooltip — CSS only!">Hover for tooltip ℹ️</span>
          <nav class="nanocss-nav" style="display: inline-flex;" aria-label="breadcrumb">
            <ol style="display: flex; list-style: none; padding: 0; margin: 0; gap: 0.25rem; font-size: 0.8125rem;">
              <li><a href="#">Home</a></li>
              <li style="margin: 0 0.25rem; color: var(--nanocss-neutral-400);">/</li>
              <li>Current Page</li>
            </ol>
          </nav>
        </div>

        <%# Pagination %>
        <ul class="nanocss-pagination" style="list-style: none; padding: 0; margin: 0;">
          <li class="disabled"><span>‹</span></li>
          <li class="active"><span>1</span></li>
          <li><a href="#">2</a></li>
          <li><a href="#">3</a></li>
          <li><a href="#">›</a></li>
        </ul>

      </div><%# /preview-window-content %>
    </div><%# /preview-window %>

    <p style="text-align: center; color: var(--chrome-muted); font-size: 0.8125rem; margin-top: 1.5rem;">
      Every element above uses <code style="background: rgba(255,255,255,0.08); padding: 0.1em 0.4em; border-radius: 0.25rem; color: #a855f7;">var(--nanocss-*)</code> custom properties — no hardcoded values.
    </p>
  </div>
</section>
