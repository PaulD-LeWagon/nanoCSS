<div style="display: flex; flex: 1; height: calc(100vh - 73px);">
  <!-- LEFT PANE: CONFIG SIDEBAR -->
  <aside class="glass-panel" style="width: 420px; border-radius: 0; border: none; border-right: 1px solid var(--color-border); overflow-y: auto; padding: 2rem;">
    <h2 style="font-size: 1.5rem; margin-bottom: 2rem;">Theme Tokens</h2>
    
    <%= form_with model: @config, url: theme_preview_path, method: :post, data: { turbo_stream: true } do |f| %>

      <%# ===== BRAND COLOURS (Always visible — Basic Mode) ===== %>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem;">
        <div class="form-group" style="margin: 0;">
          <%= f.label :primary, "Primary", class: "form-label" %>
          <%= f.color_field :primary, oninput: "this.form.requestSubmit()", style: "width: 100%; height: 3rem; border:none; border-radius: 0.25rem; background: transparent; cursor: pointer;" %>
        </div>
        <div class="form-group" style="margin: 0;">
          <%= f.label :secondary, "Secondary", class: "form-label" %>
          <%= f.color_field :secondary, oninput: "this.form.requestSubmit()", style: "width: 100%; height: 3rem; border:none; border-radius: 0.25rem; background: transparent; cursor: pointer;" %>
        </div>
        <div class="form-group" style="margin: 0;">
          <%= f.label :tertiary, "Tertiary", class: "form-label" %>
          <%= f.color_field :tertiary, oninput: "this.form.requestSubmit()", style: "width: 100%; height: 3rem; border:none; border-radius: 0.25rem; background: transparent; cursor: pointer;" %>
        </div>
      </div>

      <%# ===== HARMONY (Sprint 2 placeholder — functional stub) ===== %>
      <div class="form-group">
        <label class="form-label">Auto Harmony</label>
        <button type="button" class="btn btn-outline" style="width: 100%; padding: 0.5rem;" onclick="document.getElementById('theme_configuration_secondary').value = '#f6af3b'; this.form.requestSubmit()">Complementary</button>
      </div>

      <div style="margin: 1.5rem 0; border-bottom: 1px solid var(--color-border);"></div>

      <%# ===== FONTS (Always visible — Basic Mode per UC-002 AC1) ===== %>
      <div class="form-group">
        <%= f.label :font_heading, "Headings Font", class: "form-label" %>
        <%= f.text_field :font_heading, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :font_subtitle, "Subtitle Font", class: "form-label" %>
        <%= f.text_field :font_subtitle, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :font_body, "Body Font", class: "form-label" %>
        <%= f.text_field :font_body, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :font_code, "Code Font", class: "form-label" %>
        <%= f.text_field :font_code, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>

      <div style="margin: 1.5rem 0; border-bottom: 1px solid var(--color-border);"></div>

      <%# ===== ANCHOR VARIABLES (Always visible — Basic Mode per UC-002 AC1) ===== %>
      <div class="form-group">
        <%= f.label :base_typography, "Typography Base", class: "form-label" %>
        <%= f.text_field :base_typography, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :base_space, "Spacing Base", class: "form-label" %>
        <%= f.text_field :base_space, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :base_radius, "Border Radius Base", class: "form-label" %>
        <%= f.text_field :base_radius, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :base_border_width, "Border Width Base", class: "form-label" %>
        <%= f.text_field :base_border_width, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>

      <div style="margin: 1.5rem 0; border-bottom: 1px solid var(--color-border);"></div>

      <%# ===== ADVANCED OPTIONS TOGGLE ===== %>
      <div class="form-group">
        <label class="form-label" style="display: flex; align-items: center; cursor: pointer;">
          <input type="checkbox" id="advanced-toggle" style="margin-right: 0.5rem;" onchange="
            const opts = document.getElementById('advanced-options');
            if(this.checked) {
              opts.style.display = 'block';
              opts.style.opacity = '1';
            } else {
              opts.style.display = 'none';
              opts.style.opacity = '0';
            }
          ">
          Advanced Options
        </label>
      </div>

      <div id="advanced-options" style="display: none; transition: opacity 0.3s ease;">
        <div class="form-group">
          <%= f.label :base_margin, "Margin Base", class: "form-label" %>
          <%= f.text_field :base_margin, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :prefix, "Namespace Prefix", class: "form-label" %>
          <%= f.text_field :prefix, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :text_shadow, "Text Shadow", class: "form-label" %>
          <%= f.text_field :text_shadow, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :drop_shadow, "Drop Shadow", class: "form-label" %>
          <%= f.text_field :drop_shadow, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
      </div>
      
      <div style="margin: 1.5rem 0; border-bottom: 1px solid var(--color-border);"></div>
      
      <%# ===== ACTION BUTTONS ===== %>
      <div style="display: flex; gap: 1rem; flex-direction: column;">
        <%= f.submit "Download", formaction: theme_download_path, formmethod: :post, data: { turbo: false }, class: "btn btn-primary" %>
        <button type="button" class="btn btn-outline" onclick="navigator.clipboard.writeText(window.location.origin + '/configure?theme=<%= @config.to_base64 %>'); alert('Share link copied to clipboard!');">Copy Share Link</button>
      </div>
    <% end %>
  </aside>

  <!-- RIGHT PANE: PREVIEW CANVAS -->
  <%# The preview pane is styled ENTIRELY by the compiled nanoCSS output.
      Every element uses var(--nanocss-*) CSS custom properties.
      When Turbo Stream replaces the <style> tag, everything updates visually. %>
  <section id="preview-canvas" style="flex: 1; overflow-y: auto; position: relative;">
    <div id="nanocss-preview-style"><style><%= @css %></style></div>

    <%# Scoping container — inherits all nanoCSS base styling %>
    <div style="max-width: 800px; margin: 0 auto; padding: var(--<%= @config.prefix %>-space-xl, 2rem);">

      <h1>Fluid Heading</h1>
      <p>This preview is a <strong>living example</strong> of your nanoCSS framework. Every element on this page is styled using the CSS your configuration generates — <em>no hardcoded inline styles</em>. Change any input and watch everything transform instantly.</p>

      <h2>Typography Scale</h2>
      <p>Body text uses <code>var(--<%= @config.prefix %>-font-body)</code>, headings use <code>var(--<%= @config.prefix %>-font-heading)</code>, and this inline code sample uses <code>var(--<%= @config.prefix %>-font-code)</code>.</p>

      <blockquote>
        Blockquotes get a branded left border using the primary colour. This demonstrates the semantic styling that ships with every nanoCSS build.
      </blockquote>

      <h3>Buttons</h3>
      <p>These are plain <code>&lt;button&gt;</code> elements — they receive the primary brand colour automatically from the base stylesheet:</p>
      <div style="display: flex; gap: var(--<%= @config.prefix %>-space-md, 0.5rem); flex-wrap: wrap; margin-bottom: var(--<%= @config.prefix %>-margin-md, 1.25rem);">
        <button>Primary Action</button>
        <button style="background-color: var(--<%= @config.prefix %>-secondary);">Secondary</button>
        <button style="background-color: var(--<%= @config.prefix %>-tertiary);">Tertiary</button>
        <button style="background-color: var(--<%= @config.prefix %>-success);">Success</button>
        <button style="background-color: var(--<%= @config.prefix %>-danger);">Danger</button>
      </div>

      <h3>Form Elements</h3>
      <form onsubmit="return false;" style="margin-bottom: var(--<%= @config.prefix %>-margin-md, 1.25rem);">
        <label for="preview-input">Text Input</label>
        <input type="text" id="preview-input" placeholder="Type something...">
        <label for="preview-select" style="margin-top: var(--<%= @config.prefix %>-space-md, 0.5rem);">Select</label>
        <select id="preview-select">
          <option>Option Alpha</option>
          <option>Option Bravo</option>
          <option>Option Charlie</option>
        </select>
      </form>

      <h3>Code Block</h3>
      <pre><code>/* Your generated CSS custom properties */
:root {
  --<%= @config.prefix %>-primary: <%= @config.primary %>;
  --<%= @config.prefix %>-font-heading: "<%= @config.font_heading %>";
  --<%= @config.prefix %>-font-code: "<%= @config.font_code %>";
}</code></pre>

      <h3>Table</h3>
      <table>
        <thead>
          <tr>
            <th>Token</th>
            <th>Variable</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Primary</td><td><code>--<%= @config.prefix %>-primary</code></td><td style="color: var(--<%= @config.prefix %>-primary);"><strong><%= @config.primary %></strong></td></tr>
          <tr><td>Secondary</td><td><code>--<%= @config.prefix %>-secondary</code></td><td style="color: var(--<%= @config.prefix %>-secondary);"><strong><%= @config.secondary %></strong></td></tr>
          <tr><td>Tertiary</td><td><code>--<%= @config.prefix %>-tertiary</code></td><td style="color: var(--<%= @config.prefix %>-tertiary);"><strong><%= @config.tertiary %></strong></td></tr>
          <tr><td>Heading Font</td><td><code>--<%= @config.prefix %>-font-heading</code></td><td><%= @config.font_heading %></td></tr>
          <tr><td>Code Font</td><td><code>--<%= @config.prefix %>-font-code</code></td><td><%= @config.font_code %></td></tr>
        </tbody>
      </table>

      <h3>Accordion (Native &lt;details&gt;)</h3>
      <details>
        <summary>Click to expand — this is a native HTML5 accordion</summary>
        <p>This <code>&lt;details&gt;</code> element is styled entirely by nanoCSS base styles. No JavaScript required. The border, padding, and chevron rotation all come from your compiled CSS.</p>
      </details>

      <hr>

      <h3>Semantic Colours</h3>
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--<%= @config.prefix %>-space-md, 0.5rem);">
        <div style="background: var(--<%= @config.prefix %>-success); color: white; padding: var(--<%= @config.prefix %>-space-md, 0.5rem); border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); text-align: center; font-weight: var(--<%= @config.prefix %>-weight-bold, 700);">Success</div>
        <div style="background: var(--<%= @config.prefix %>-info); color: white; padding: var(--<%= @config.prefix %>-space-md, 0.5rem); border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); text-align: center; font-weight: var(--<%= @config.prefix %>-weight-bold, 700);">Info</div>
        <div style="background: var(--<%= @config.prefix %>-warning); color: white; padding: var(--<%= @config.prefix %>-space-md, 0.5rem); border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); text-align: center; font-weight: var(--<%= @config.prefix %>-weight-bold, 700);">Warning</div>
        <div style="background: var(--<%= @config.prefix %>-danger); color: white; padding: var(--<%= @config.prefix %>-space-md, 0.5rem); border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); text-align: center; font-weight: var(--<%= @config.prefix %>-weight-bold, 700);">Danger</div>
      </div>

      <hr>
      <p><small>This preview renders using only the nanoCSS output your configuration produces — semantic HTML with zero hardcoded styling.</small></p>
    </div>
  </section>
</div>
