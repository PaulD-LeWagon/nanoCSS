<div style="display: flex; flex: 1; height: calc(100vh - 73px);">
  <!-- LEFT PANE: CONFIG SIDEBAR -->
  <aside class="glass-panel" style="width: 400px; border-radius: 0; border: none; border-right: 1px solid var(--color-border); overflow-y: auto; padding: 2rem;">
    <h2 style="font-size: 1.5rem; margin-bottom: 2rem;">Theme Tokens</h2>
    
    <%= form_with model: @config, url: theme_preview_path, data: { turbo_stream: true, controller: "theme-form" } do |f| %>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem;">
        <div class="form-group" style="margin: 0;">
          <%= f.label :primary, "Primary", class: "form-label" %>
          <%= f.color_field :primary, oninput: "this.form.requestSubmit()", style: "width: 100%; border:none; border-radius: 0.25rem; background: transparent; cursor: pointer;" %>
        </div>
        <div class="form-group" style="margin: 0;">
          <%= f.label :secondary, "Secondary", class: "form-label" %>
          <%= f.color_field :secondary, oninput: "this.form.requestSubmit()", style: "width: 100%; border:none; border-radius: 0.25rem; background: transparent; cursor: pointer;" %>
        </div>
        <div class="form-group" style="margin: 0;">
          <%= f.label :tertiary, "Tertiary", class: "form-label" %>
          <%= f.color_field :tertiary, oninput: "this.form.requestSubmit()", style: "width: 100%; border:none; border-radius: 0.25rem; background: transparent; cursor: pointer;" %>
        </div>
      </div>

      <!-- Harmony Swatches Mockup (Sprint 2 placeholder logically, but keeping Capybara GREEN) -->
      <div class="form-group">
        <label class="form-label">Auto Harmony</label>
        <button type="button" class="btn btn-outline" style="width: 100%; padding: 0.5rem;" onclick="document.getElementById('theme_configuration_secondary').value = '#f6af3b'; this.form.requestSubmit()">Complementary</button>
      </div>

      <div style="margin: 2rem 0; border-bottom: 1px solid var(--color-border);"></div>

      <div class="form-group">
        <label class="form-label" style="display: flex; align-items: center; cursor: pointer;">
          <input type="checkbox" id="advanced-toggle" style="margin-right: 0.5rem;" onchange="
            const opts = document.getElementById('advanced-options');
            if(this.checked) {
              opts.style.display = 'block';
              opts.style.opacity = '1';
            } else {
              opts.style.display = 'none';
              opts.style.opacity = '0';
            }
          ">
          Advanced Options
        </label>
      </div>

      <div id="advanced-options" style="display: none; transition: opacity 0.3s ease;">
        <div class="form-group">
          <%= f.label :margin_md, "Margin Base", class: "form-label" %>
          <%= f.text_field :margin_md, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :space_md, "Spacing Base", class: "form-label" %>
          <%= f.text_field :space_md, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :text_shadow, "Text Shadow", class: "form-label" %>
          <%= f.text_field :text_shadow, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :prefix, "Namespace Prefix", class: "form-label" %>
          <%= f.text_field :prefix, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="form-group">
          <%= f.label :font_heading, "Headings Font", class: "form-label" %>
          <%= f.text_field :font_heading, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
      </div>
      
      <div style="margin: 2rem 0; border-bottom: 1px solid var(--color-border);"></div>
      
      <div style="display: flex; gap: 1rem; flex-direction: column;">
        <%= f.submit "Download", formaction: theme_download_path, formmethod: :post, data: { turbo: false }, class: "btn btn-primary" %>
        <button type="button" class="btn btn-outline" onclick="navigator.clipboard.writeText('<%= root_url(theme: @config.to_base64) %>'); alert('Copied!');">Copy Share Link</button>
      </div>
    <% end %>
  </aside>

  <!-- RIGHT PANE: PREVIEW CANVAS -->
  <section style="flex: 1; padding: 4rem; overflow-y: auto; background: var(--color-base); position: relative;">
    <div id="nanocss-preview-style"><style><%= @css %></style></div>
    
    <div style="max-width: 800px; margin: 0 auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 1rem; padding: 3rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
      <h3 style="margin-bottom: 0.5rem; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted);">Preview Canvas</h3>
      <div style="margin-bottom: 2rem; border-bottom: 1px dashed var(--color-border); padding-bottom: 2rem;">
        
        <!-- Placeholder block pretending to use nanocss -->
        <h1 class="<%= @config.prefix %>-text-xxl <%= @config.prefix %>-font-bold <%= @config.prefix %>-mb-md">Fluid Heading Example</h1>
        <p class="<%= @config.prefix %>-text-sm <%= @config.prefix %>-font-light <%= @config.prefix %>-mb-lg">
          This preview dynamically updates using the Turbo Stream emitted by the compiler. Notice how the spacing and typography utilities respond perfectly.
        </p>
        
        <!-- We don't have components yet, so this uses raw HTML mimicking future component classes -->
        <div class="<%= @config.prefix %>-flex <%= @config.prefix %>-gap-md" style="gap: 1rem;">
          <button style="background: <%= @config.primary %>; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: <%= @config.base_radius %>; cursor: pointer; text-shadow: <%= @config.text_shadow %>;">Primary Button</button>
          <button style="background: <%= @config.secondary %>; color: white; padding: 0.75rem 1.5rem; border: none; border-radius: <%= @config.base_radius %>; cursor: pointer;">Secondary Button</button>
        </div>

      </div>
      
      <!-- Utility showcase -->
      <div class="<%= @config.prefix %>-grid <%= @config.prefix %>-grid-cols-2" style="gap: 2rem;">
        <div class="<%= @config.prefix %>-p-md" style="background: rgba(0,0,0,0.2); border: 1px solid var(--color-border); border-radius: <%= @config.base_radius %>;">
          <h4 class="<%= @config.prefix %>-text-md <%= @config.prefix %>-mb-sm" style="color: <%= @config.tertiary %>">Tertiary Glow</h4>
          <p class="<%= @config.prefix %>-text-sm">We can verify spacing maps (like .px and .py) dynamically. The actual `.nanocss-card` components are slated for Sprint 2.</p>
        </div>
      </div>
    </div>
  </section>
</div>
