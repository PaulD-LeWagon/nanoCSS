<%# Configuration Page — SCR-002
    Traces: design/BACKLOG.md UC-002, UC-003, UC-004, UC-006
    Layout: configure-layout (sidebar + preview) defined in application.css %>

<div class="configure-layout">

  <%# ── LEFT: Config Sidebar ─────────────────────────────────────────────── %>
  <aside class="config-sidebar">
    <h2>Theme Tokens</h2>

    <%= form_with model: @config, url: theme_preview_path, method: :post, data: { turbo_stream: true } do |f| %>

      <div id="validation-errors"></div>

      <%# Brand Colours — always visible (Basic Mode AC1) %>
      <div class="config-token-grid">
        <div>
          <%= f.label :primary, "Primary", class: "form-label" %>
          <%= f.color_field :primary, oninput: "this.form.requestSubmit()", style: "width:100%; height:2.75rem; border:1px solid var(--chrome-border); border-radius:0.5rem; background:transparent; cursor:pointer; padding:0.2rem;" %>
        </div>
        <div>
          <%= f.label :secondary, "Secondary", class: "form-label" %>
          <%= f.color_field :secondary, oninput: "this.form.requestSubmit()", style: "width:100%; height:2.75rem; border:1px solid var(--chrome-border); border-radius:0.5rem; background:transparent; cursor:pointer; padding:0.2rem;" %>
        </div>
        <div>
          <%= f.label :tertiary, "Tertiary", class: "form-label" %>
          <%= f.color_field :tertiary, oninput: "this.form.requestSubmit()", style: "width:100%; height:2.75rem; border:1px solid var(--chrome-border); border-radius:0.5rem; background:transparent; cursor:pointer; padding:0.2rem;" %>
        </div>
      </div>

      <%# Auto Harmony (UC-006) %>
      <div id="harmony-options">
        <%= render partial: "themes/harmony_options", locals: { config: @config, complementary: @complementary, analogous: @analogous, triadic: @triadic, monochromatic: @monochromatic, split_complementary: @split_complementary } %>
      </div>

      <hr class="config-divider">

      <div data-controller="fonts" class="config-font-group">
        <div data-fonts-target="dropdownContainer" class="custom-font-select">
          <%= f.label :font_heading, "Headings Font", class: "form-label" %>
          <div class="config-font-trigger">
            <input type="text" class="form-input" data-fonts-target="searchInput" data-action="focus->fonts#open input->fonts#search keydown->fonts#handleKeydown" value="<%= @config.font_heading || "System Default" %>" style="width: 100%; font-family: '<%= @config.font_heading %>'; padding-right: 2rem; cursor: pointer;">
            <span class="config-font-arrow">▼</span>
          </div>
          <div class="font-dropdown-list"></div>
          <%= f.hidden_field :font_heading, data: { fonts_target: "hiddenInput" }, onchange: "this.form.requestSubmit()" %>
        </div>

        <div data-fonts-target="dropdownContainer" class="custom-font-select">
          <%= f.label :font_subtitle, "Subtitle Font", class: "form-label" %>
          <div class="config-font-trigger">
            <input type="text" class="form-input" data-fonts-target="searchInput" data-action="focus->fonts#open input->fonts#search keydown->fonts#handleKeydown" value="<%= @config.font_subtitle || "System Default" %>" style="width: 100%; font-family: '<%= @config.font_subtitle %>'; padding-right: 2rem; cursor: pointer;">
            <span class="config-font-arrow">▼</span>
          </div>
          <div class="font-dropdown-list"></div>
          <%= f.hidden_field :font_subtitle, data: { fonts_target: "hiddenInput" }, onchange: "this.form.requestSubmit()" %>
        </div>

        <div data-fonts-target="dropdownContainer" class="custom-font-select">
          <%= f.label :font_body, "Body Font", class: "form-label" %>
          <div class="config-font-trigger">
            <input type="text" class="form-input" data-fonts-target="searchInput" data-action="focus->fonts#open input->fonts#search keydown->fonts#handleKeydown" value="<%= @config.font_body || "System Default" %>" style="width: 100%; font-family: '<%= @config.font_body %>'; padding-right: 2rem; cursor: pointer;">
            <span class="config-font-arrow">▼</span>
          </div>
          <div class="font-dropdown-list"></div>
          <%= f.hidden_field :font_body, data: { fonts_target: "hiddenInput" }, onchange: "this.form.requestSubmit()" %>
        </div>

        <div data-fonts-target="dropdownContainer" class="custom-font-select">
          <%= f.label :font_code, "Code Font", class: "form-label" %>
          <div class="config-font-trigger">
            <input type="text" class="form-input" data-fonts-target="searchInput" data-action="focus->fonts#open input->fonts#search keydown->fonts#handleKeydown" value="<%= @config.font_code || "System Default" %>" style="width: 100%; font-family: '<%= @config.font_code %>'; padding-right: 2rem; cursor: pointer;">
            <span class="config-font-arrow">▼</span>
          </div>
          <div class="font-dropdown-list"></div>
          <%= f.hidden_field :font_code, data: { fonts_target: "hiddenInput" }, onchange: "this.form.requestSubmit()" %>
        </div>
      </div>

      <hr class="config-divider">

      <%# Anchor Variables — Basic Mode (AC1) %>
      <div class="config-anchor-group">
        <div>
        <%= f.label :base_typography, "Typography Base", class: "form-label" %>
        <%= f.text_field :base_typography, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div>
        <%= f.label :base_space, "Spacing Base", class: "form-label" %>
        <%= f.text_field :base_space, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div>
        <%= f.label :base_radius, "Border Radius Base", class: "form-label" %>
        <%= f.text_field :base_radius, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
      <div>
        <%= f.label :base_border_width, "Border Width Base", class: "form-label" %>
        <%= f.text_field :base_border_width, class: "form-input", oninput: "this.form.requestSubmit()" %>
      </div>
    </div>

      <hr class="config-divider">

      <%# Advanced toggle (AC-UC002) %>
      <div>
        <label class="form-label config-toggle-label">
          <input type="checkbox" id="advanced-toggle"
            onchange="const opts=document.getElementById('advanced-options'); opts.style.display=this.checked?'block':'none';">
          Advanced Options
        </label>
      </div>

      <div id="advanced-options" class="config-advanced-hidden">
        <div>
          <%= f.label :prefix, "Namespace Prefix", class: "form-label" %>
          <%= f.text_field :prefix, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="config-section">
          <label class="form-label config-toggle-label">
            <%= f.check_box :wrap_in_layer, onchange: "this.form.requestSubmit()" %>
            Wrap in CSS @layer
          </label>
          <small class="config-hint">Encapsulates output to prevent specificity collisions.</small>
        </div>
        <div>
          <%= f.label :base_margin, "Margin Base", class: "form-label" %>
          <%= f.text_field :base_margin, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="config-mt-lg">
          <%= f.label :text_shadow, "Text Shadow", class: "form-label" %>
          <%= f.text_field :text_shadow, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>
        <div class="config-mt-md">
          <%= f.label :drop_shadow, "Drop Shadow", class: "form-label" %>
          <%= f.text_field :drop_shadow, class: "form-input", oninput: "this.form.requestSubmit()" %>
        </div>

        <hr class="config-divider">
        <%# Tier Selection (FR-005) %>
        <div class="config-mb-md">
          <label class="form-label">Framework Tier</label>
          <div class="config-tier-options">
            <label class="config-tier-label">
              <%= f.radio_button :tier, "nano", onchange: "this.form.requestSubmit()" %> Nano
            </label>
            <label class="config-tier-label">
              <%= f.radio_button :tier, "standard", onchange: "this.form.requestSubmit()" %> Standard
            </label>
            <label class="config-tier-label">
              <%= f.radio_button :tier, "full", onchange: "this.form.requestSubmit()" %> Full
            </label>
          </div>
          <small class="config-hint-block">
            Nano: Elements only. Standard: Utilities. Full: Interactive components.
          </small>
        </div>

        <%# Excluded Components (AC1-UC010) %>
        <div>
          <label class="form-label">Omit Components</label>
          <small class="config-hint-block-mb">
            Check a component to exclude it from the final CSS compilation and zip export.
          </small>
          <div class="config-components-grid">
            <% ThemeConfiguration::VALID_COMPONENTS.each do |comp| %>
              <label class="config-component-label">
                <%= check_box_tag "theme_configuration[excluded_components][]", comp, @config.excluded_components.include?(comp), onchange: "this.form.requestSubmit()", id: "omit_#{comp}" %>
                <%= comp.capitalize %>
              </label>
            <% end %>
          </div>
          <%# Hidden field to ensure empty array is sent if all boxes are unchecked %>
          <%= hidden_field_tag "theme_configuration[excluded_components][]", "" %>
        </div>
      </div>

      <hr class="config-divider">

      <%# Actions %>
      <div class="config-actions">
        <div class="config-download-group">
          <%= f.button "⬇ .css", name: "download_format", value: "css", formaction: theme_download_path, formmethod: :post, data: { turbo: false }, class: "btn-hero-primary", style: "flex:1; justify-content:center; text-decoration:none; padding: 0.5rem; font-size: 0.85rem;" %>
          <%= f.button "⬇ .min.css", name: "download_format", value: "min", formaction: theme_download_path, formmethod: :post, data: { turbo: false }, class: "btn-hero-primary", style: "flex:1; justify-content:center; text-decoration:none; padding: 0.5rem; font-size: 0.85rem;" %>
          <%= f.button "⬇ .scss", name: "download_format", value: "scss", formaction: theme_download_path, formmethod: :post, data: { turbo: false }, class: "btn-hero-primary", style: "flex:1; justify-content:center; text-decoration:none; padding: 0.5rem; font-size: 0.85rem;" %>
        </div>

        <button type="button" class="btn-preset-outline" id="share-link-btn"
          onclick="navigator.clipboard.writeText(window.location.origin + '/configure?theme=<%= @config.to_base64 %>'); alert('Share link copied!');">
          🔗 Copy Share Link
        </button>

        <%= link_to "↺ Reset to Defaults", configure_path,
              class: "btn-preset-outline",
              style: "text-align:center; text-decoration:none; color: var(--chrome-muted);" %>
      </div>

    <% end %>
  </aside>

  <%# ── RIGHT: Preview Canvas ─────────────────────────────────────────────── %>
  <section class="preview-canvas" id="preview-canvas" data-controller="preview">

    <%# The style tag Turbo Stream targets to update all nanocss vars in the preview %>
    <div id="nanocss-preview-style">
      <link rel="stylesheet" href="<%= theme_css_path(theme: @config.to_base64, preview: true) %>" data-action="load->preview#onStyleLoad">
    </div>

    <div class="preview-inner">
      <div class="preview-window" data-preview-target="window">
        <%# Fake browser chrome bar %>
        <div class="preview-window-bar">
          <span class="preview-window-dot"></span>
          <span class="preview-window-dot"></span>
          <span class="preview-window-dot"></span>
          <span class="preview-window-url">your-project.com — styled by <%= @config.prefix %></span>
        </div>

        <%# Preview content %>
        <div class="preview-window-content" style="background: var(--<%= @config.prefix %>-neutral-50, #fff); color: var(--<%= @config.prefix %>-neutral-900, #111827);">
          <%# Hero component %>
          <section class="<%= @config.prefix %>-hero preview-hero-compact">
            <hgroup class="preview-hgroup-center">
              <h1 style="font-family: var(--<%= @config.prefix %>-font-heading); font-size: var(--<%= @config.prefix %>-text-xl); margin-bottom: 0.25rem;">Your Site Headline</h1>
              <p style="font-family: var(--<%= @config.prefix %>-font-subtitle); color: var(--<%= @config.prefix %>-neutral-500); margin: 0;">Styled entirely by your compiled <%= @config.prefix %> framework</p>
            </hgroup>
            <div class="preview-cta-row">
              <button class="<%= @config.prefix %>-btn-primary">Get Started</button>
              <button class="<%= @config.prefix %>-btn-outline">Learn More</button>
            </div>
          </section>

          <%# Colour brand swatches %>
          <div class="preview-brand-swatches">
            <div style="background: var(--<%= @config.prefix %>-primary); height: 3rem; border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem; font-weight: 600;">Primary</div>
            <div style="background: var(--<%= @config.prefix %>-secondary); height: 3rem; border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem; font-weight: 600;">Secondary</div>
            <div style="background: var(--<%= @config.prefix %>-tertiary); height: 3rem; border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.75rem; font-weight: 600;">Tertiary</div>
          </div>

          <%# Nav Component %>
          <nav class="<%= @config.prefix %>-nav preview-nav-mb" style="border-radius: var(--<%= @config.prefix %>-radius-md, 0.25rem);">
            <strong>BrandLogo</strong>
            <ul class="nav-menu">
              <li><a href="#">Home</a></li>
              <li><a href="#">About</a></li>
              <li><a href="#">Contact</a></li>
            </ul>
          </nav>

          <%# Cards with Badges %>
          <div class="preview-cards-grid">
            <article class="<%= @config.prefix %>-card-primary">
              <header>
                Primary Card
                <span class="<%= @config.prefix %>-badge" style="margin-left: 0.5rem; background: rgba(255,255,255,0.25); color: #fff;">New</span>
              </header>
              <div class="card-body">
                <p class="preview-card-text">Header uses your <code>--<%= @config.prefix %>-primary</code> brand colour.</p>
              </div>
              <footer>
                <button class="<%= @config.prefix %>-btn-primary" style="font-size: 0.8125rem; padding: 0.375rem 0.875rem;">View →</button>
              </footer>
            </article>
            <article class="<%= @config.prefix %>-card-secondary">
              <header>
                Secondary Card
                <span class="<%= @config.prefix %>-badge warning" style="margin-left: 0.5rem;">Beta</span>
              </header>
              <div class="card-body">
                <p class="preview-card-text">Header uses your <code>--<%= @config.prefix %>-secondary</code> colour.</p>
              </div>
              <footer>
                <button class="<%= @config.prefix %>-btn-secondary" style="font-size: 0.8125rem; padding: 0.375rem 0.875rem;">Details</button>
              </footer>
            </article>
            <article class="<%= @config.prefix %>-card-neutral">
              <header>Neutral Card</header>
              <div class="card-body">
                <p class="preview-card-text">Muted header using the neutral shade scale — great for secondary content.</p>
              </div>
              <footer>Info only</footer>
            </article>
          </div>

          <%# Tabs %>
          <div class="<%= @config.prefix %>-tabs preview-tabs-mb">
            <input type="radio" id="prev-tab1" name="preview_tabs" checked />
            <label for="prev-tab1">Typography</label>
            <div class="panel" id="panel1">
              <blockquote>The blockquote border uses the <strong>primary</strong> brand colour — watch it change.</blockquote>
              <p style="font-family: var(--<%= @config.prefix %>-font-body);">Body copy in <code>--<%= @config.prefix %>-font-body</code>. Heading in <code>--<%= @config.prefix %>-font-heading</code>.</p>
            </div>
            <input type="radio" id="prev-tab2" name="preview_tabs" />
            <label for="prev-tab2">Forms</label>
            <div class="panel" id="panel2">
              <label for="preview-name">Your name</label>
              <input type="text" id="preview-name" placeholder="e.g. Jane Smith" class="preview-input-mb">
              <label for="preview-select">Tier</label>
              <select id="preview-select">
                <option>Nano (base styles only)</option>
                <option>Standard (+ utilities)</option>
                <option>Full (+ components)</option>
              </select>
            </div>
            <input type="radio" id="prev-tab3" name="preview_tabs" />
            <label for="prev-tab3">Feedback</label>
            <div class="panel" id="panel3">
              <div class="preview-badge-row">
                <span class="<%= @config.prefix %>-badge success">Online</span>
                <span class="<%= @config.prefix %>-badge warning">Pending</span>
                <span class="<%= @config.prefix %>-badge danger">Error</span>
                <span class="<%= @config.prefix %>-badge">Draft</span>
              </div>
              <progress value="65" max="100" class="preview-progress-mb">65%</progress>
              <div class="preview-loader-row">
                <span class="<%= @config.prefix %>-loader"></span>
                <span style="font-size: 0.875rem; color: var(--<%= @config.prefix %>-neutral-500);">Processing...</span>
              </div>
            </div>
          </div>

          <%# Accordion + Tooltip %>
          <details class="preview-accordion-mb">
            <summary>Accordion — click to expand</summary>
            <p class="preview-accordion-text">Zero JavaScript — native <code>&lt;details&gt;</code> styled by the base layer. The chevron, border, and padding all come from your config.</p>
          </details>

          <div class="preview-utils-row">
            <span tabindex="0" data-tooltip="No JS tooltip — CSS only!">Hover for tooltip ℹ️</span>
            <nav class="<%= @config.prefix %>-breadcrumb" aria-label="breadcrumb">
              <ol>
                <li><a href="#">Home</a></li>
                <li>Current Page</li>
              </ol>
            </nav>
          </div>

          <%# Pagination %>
          <ul class="<%= @config.prefix %>-pagination" style="list-style: none; padding: 0; margin: 0;">
            <li class="disabled"><span>‹</span></li>
            <li class="active"><span>1</span></li>
            <li><a href="#">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#">›</a></li>
          </ul>

        </div><%# /preview-window-content %>
      </div><%# /preview-window %>

      <p class="preview-footer-note">
        Every element above uses <code class="preview-code-highlight">var(--<%= @config.prefix %>-*)</code> custom properties — no hardcoded values.
      </p>
    </div><%# /inner %>
  </section>

</div><%# /configure-layout %>
