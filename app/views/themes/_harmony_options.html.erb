<%# Harmony Options Partial — rendered by ThemesController#show and replaced via Turbo Stream
    on ThemesController#preview when the primary colour changes.
    Traces: design/BACKLOG.md UC-006 %>

<div class="form-group" id="harmony-options">
  <label class="form-label" style="color: var(--chrome-muted);">Auto Harmony</label>
  <div style="display: flex; flex-direction: column; gap: 0.4rem;">

    <% if defined?(complementary) && complementary.present? %>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <button type="button" class="harmony-swatch-btn" style="flex:1;"
          onclick="document.getElementById('theme_configuration_secondary').value='<%= complementary[0] %>';
                   document.getElementById('theme_configuration_tertiary').value='<%= complementary[1] %>';
                   this.closest('form').requestSubmit()">
          Complementary
        </button>
        <div class="swatch-box" style="background:<%= complementary[0] %>;"></div>
        <div class="swatch-box" style="background:<%= complementary[1] %>;"></div>
      </div>
    <% end %>

    <% if defined?(analogous) && analogous.present? %>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <button type="button" class="harmony-swatch-btn" style="flex:1;"
          onclick="document.getElementById('theme_configuration_secondary').value='<%= analogous[0] %>';
                   document.getElementById('theme_configuration_tertiary').value='<%= analogous[1] %>';
                   this.closest('form').requestSubmit()">
          Analogous
        </button>
        <div class="swatch-box" style="background:<%= analogous[0] %>;"></div>
        <div class="swatch-box" style="background:<%= analogous[1] %>;"></div>
      </div>
    <% end %>

    <% if defined?(triadic) && triadic.present? %>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <button type="button" class="harmony-swatch-btn" style="flex:1;"
          onclick="document.getElementById('theme_configuration_secondary').value='<%= triadic[0] %>';
                   document.getElementById('theme_configuration_tertiary').value='<%= triadic[1] %>';
                   this.closest('form').requestSubmit()">
          Triadic
        </button>
        <div class="swatch-box" style="background:<%= triadic[0] %>;"></div>
        <div class="swatch-box" style="background:<%= triadic[1] %>;"></div>
      </div>
    <% end %>

  </div>
</div>
