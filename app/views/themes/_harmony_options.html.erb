<%# Harmony Options Partial — rendered by ThemesController#show and replaced via Turbo Stream
    on ThemesController#preview when the primary colour changes.
    Per UC-027: swatch buttons use Stimulus data-action (no inline onclick ERB interpolation).
    Traces: design/BACKLOG.md UC-006, UC-027 %>

<div class="form-group" id="harmony-options" data-controller="harmony">
  <label class="form-label harmony-label">Auto Harmony</label>
  <div class="harmony-list">

    <% if defined?(complementary) && complementary.present? %>
      <div class="harmony-row">
        <button type="button" class="harmony-swatch-btn"
          data-action="harmony#apply"
          data-harmony-secondary="<%= complementary[0] %>"
          data-harmony-tertiary="<%= complementary[1] %>">
          Complementary
        </button>
        <div class="swatch-box" style="background:<%= complementary[0] %>;"></div>
        <div class="swatch-box" style="background:<%= complementary[1] %>;"></div>
      </div>
    <% end %>

    <% if defined?(analogous) && analogous.present? %>
      <div class="harmony-row">
        <button type="button" class="harmony-swatch-btn"
          data-action="harmony#apply"
          data-harmony-secondary="<%= analogous[0] %>"
          data-harmony-tertiary="<%= analogous[1] %>">
          Analogous
        </button>
        <div class="swatch-box" style="background:<%= analogous[0] %>;"></div>
        <div class="swatch-box" style="background:<%= analogous[1] %>;"></div>
      </div>
    <% end %>

    <% if defined?(triadic) && triadic.present? %>
      <div class="harmony-row">
        <button type="button" class="harmony-swatch-btn"
          data-action="harmony#apply"
          data-harmony-secondary="<%= triadic[0] %>"
          data-harmony-tertiary="<%= triadic[1] %>">
          Triadic
        </button>
        <div class="swatch-box" style="background:<%= triadic[0] %>;"></div>
        <div class="swatch-box" style="background:<%= triadic[1] %>;"></div>
      </div>
    <% end %>

  </div>
</div>
