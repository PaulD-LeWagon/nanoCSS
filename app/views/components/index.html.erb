      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;dialog class="<%= @prefix %>-modal" id="my-modal"&gt;
  &lt;h2&gt;Modal Title&lt;/h2&gt;
  &lt;p&gt;Modal content goes here.&lt;/p&gt;
  &lt;button onclick="document.getElementById('my-modal').close()"&gt;Close&lt;/button&gt;
&lt;/dialog&gt;</code></pre>
      </div>
