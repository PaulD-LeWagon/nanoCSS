          <div class="card-body">Header uses <code>--<%= @prefix %>-primary</code>.</div>
          <footer><button class="<%= @prefix %>-btn-primary">Action</button></footer>
        </article>

        <article class="<%= @prefix %>-card-secondary">
          <header>Secondary</header>
          <div class="card-body">Header uses <code>--<%= @prefix %>-secondary</code>.</div>
          <footer><button class="<%= @prefix %>-btn-secondary">Action</button></footer>
        </article>

        <article class="<%= @prefix %>-card-tertiary">
          <header>Tertiary</header>
          <div class="card-body">Header uses <code>--<%= @prefix %>-tertiary</code>.</div>
          <footer><button class="<%= @prefix %>-btn-outline">Action</button></footer>
        </article>

        <article class="<%= @prefix %>-card-neutral">
          <header>Neutral</header>
          <div class="card-body">Header uses <code>--<%= @prefix %>-neutral-700</code> from the neutral shade scale.</div>
          <footer>Info only</footer>
        </article>

      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;!-- Primary --&gt;
&lt;article class="<%= @prefix %>-card-primary"&gt;...&lt;/article&gt;

&lt;!-- Secondary --&gt;
&lt;article class="<%= @prefix %>-card-secondary"&gt;...&lt;/article&gt;

&lt;!-- Tertiary --&gt;
&lt;article class="<%= @prefix %>-card-tertiary"&gt;...&lt;/article&gt;

&lt;!-- Neutral --&gt;
&lt;article class="<%= @prefix %>-card-neutral"&gt;...&lt;/article&gt;</code></pre>
      </div>
    </section>

    <!-- 5. Dropdown -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Dropdown</h2></div>
      <div class="component-preview" style="height: 200px;">
        <div class="<%= @prefix %>-dropdown" data-controller="dropdown">
          <button class="<%= @prefix %>-btn-outline" data-action="click->dropdown#toggle">Actions ▼</button>
          <ul>
            <li>Edit Profile</li>
            <li>Settings</li>
             <li>Logout</li>
