          <label for="tab3">Reviews</label>
          <div class="panel" id="panel3">Customer reviews go here. Completely semantic.</div>
        </div>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;div class="<%= @prefix %>-tabs"&gt;
  &lt;input type="radio" id="tab1" name="tabs" checked /&gt;
  &lt;label for="tab1"&gt;Tab 1&lt;/label&gt;
  &lt;div class="panel" id="panel1"&gt;Panel 1 Content&lt;/div&gt;

  &lt;input type="radio" id="tab2" name="tabs" /&gt;
  &lt;label for="tab2"&gt;Tab 2&lt;/label&gt;
  &lt;div class="panel" id="panel2"&gt;Panel 2 Content&lt;/div&gt;
&lt;/div&gt;</code></pre>
      </div>
