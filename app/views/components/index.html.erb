<% content_for :title, "Component Catalogue - nanoCSS" %>
<% content_for :head do %>
  <% if @css.present? %>
    <style id="nanocss-catalogue-styles">
      <%= @css.html_safe %>
    </style>
  <% end %>
<% end %>

<div class="catalogue-container">
  <header class="catalogue-header">
    <h1>Component Catalogue</h1>
    <p>A visual reference and code repository for all <%= @prefix %> components.</p>
  </header>

  <style>
    .catalogue-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }
    .catalogue-header {
      margin-bottom: 4rem;
      text-align: center;
    }
    .catalogue-header h1 {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 800;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, var(--chrome-text), var(--chrome-muted));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.03em;
    }
    .catalogue-header p {
      font-size: 1.25rem;
      color: var(--chrome-muted);
      max-width: 60ch;
      margin: 0 auto;
    }
    .component-section { 
      background: var(--chrome-glass); 
      backdrop-filter: blur(12px);
      border: 1px solid var(--chrome-border);
      border-radius: 1rem; 
      margin-bottom: 3rem; 
      overflow: hidden; 
      color: var(--chrome-text);
      box-shadow: 0 4px 24px -12px rgba(0,0,0,0.5);
    }
    .component-header { 
      padding: 1.5rem 2rem; 
      border-bottom: 1px solid var(--chrome-border); 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      background: rgba(255,255,255,0.03);
    }
    .component-header h2 { 
      margin: 0; 
      font-size: 1.25rem; 
      font-weight: 600; 
      font-family: sans-serif; 
    }
    .component-preview { 
      padding: 2rem; 
      background: #f8fafc; /* Keep light background so nanoCSS styles are visible */
      color: #111827;
    }
    .component-code { 
      background: #0f172a; 
      color: #f3f4f6; 
      padding: 1.5rem; 
      position: relative; 
      border-top: 1px solid var(--chrome-border);
    }
    .component-code pre { 
      margin: 0; 
      overflow-x: auto; 
      font-family: monospace; 
      font-size: 0.875rem; 
    }
    .copy-btn { 
      position: absolute; 
      top: 1rem; 
      right: 1rem; 
      background: var(--chrome-border); 
      color: white; 
      border: none; 
      padding: 0.5rem 1rem; 
      border-radius: 4px; 
      cursor: pointer; 
      transition: background 0.2s; 
    }
    .copy-btn:hover { 
      background: var(--chrome-muted); 
    }
  </style>

    <!-- 0. Text Banner -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Text Banner</h2></div>
      <div class="component-preview">
        <hgroup>
          <h1>Main Headline Here</h1>
          <p>This is the supporting subtitle text directly underneath.</p>
        </hgroup>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;hgroup&gt;
  &lt;h1&gt;Main Headline Here&lt;/h1&gt;
  &lt;p&gt;This is the supporting subtitle text directly underneath.&lt;/p&gt;
&lt;/hgroup&gt;</code></pre>
      </div>
    </section>

    <!-- 1. Hero Banner -->
    <section class="component-section" data-controller="clipboard">

      <div class="component-header">
        <h2>The Hero Banner</h2>
      </div>      
      <div class="component-preview">
        
        <section class="<%= @prefix %>-hero">
          <h1>Big Hero Headline</h1>
          <p>Supporting value prop goes here, expanding upon the headline.</p>
          <button class="<%= @prefix %>-btn-primary">Get Started</button>
        </section>

      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>

        <pre><code data-clipboard-target="source">&lt;section class="<%= @prefix %>-hero"&gt;
  &lt;h1&gt;Big Hero Headline&lt;/h1&gt;
  &lt;p&gt;Supporting value prop goes here, expanding upon the headline.&lt;/p&gt;
  &lt;button class="<%= @prefix %>-btn-primary"&gt;Get Started&lt;/button&gt;
&lt;/section&gt;</code></pre>
      </div>
    </section>

    <!-- 2. Carousel -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Carousel</h2></div>
      <div class="component-preview" style="background: #1e293b; padding: 0; border-radius: 0.5rem; overflow: hidden;">
        <div class="<%= @prefix %>-carousel" id="demo-carousel" style="border-radius: 0;">
          <div class="carousel-track" id="demo-carousel-track">
            <div class="carousel-slide" style="height: 200px; background: linear-gradient(135deg,#6366f1,#a855f7); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.5rem; font-weight:700;">Slide 1</div>
            <div class="carousel-slide" style="height: 200px; background: linear-gradient(135deg,#ec4899,#f59e0b); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.5rem; font-weight:700;">Slide 2</div>
            <div class="carousel-slide" style="height: 200px; background: linear-gradient(135deg,#10b981,#0ea5e9); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.5rem; font-weight:700;">Slide 3</div>
          </div>
          <button class="carousel-btn carousel-prev" onclick="carouselScroll('demo-carousel-track', -1)" aria-label="Previous slide">‹</button>
          <button class="carousel-btn carousel-next" onclick="carouselScroll('demo-carousel-track',  1)" aria-label="Next slide">›</button>
          <ul class="carousel-dots" id="demo-carousel-dots">
            <li class="active"></li><li></li><li></li>
          </ul>
        </div>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;div class="<%= @prefix %>-carousel"&gt;
  &lt;div class="carousel-track"&gt;
    &lt;div class="carousel-slide"&gt;Slide 1&lt;/div&gt;
    &lt;div class="carousel-slide"&gt;Slide 2&lt;/div&gt;
    &lt;div class="carousel-slide"&gt;Slide 3&lt;/div&gt;
  &lt;/div&gt;
  &lt;button class="carousel-btn carousel-prev" onclick="..."›‹&lt;/button&gt;
  &lt;button class="carousel-btn carousel-next" onclick="..."&gt;›&lt;/button&gt;
  &lt;ul class="carousel-dots"&gt;&lt;li class="active"&gt;&lt;/li&gt;...&lt;/ul&gt;
&lt;/div&gt;</code></pre>
      </div>
    </section>

    <script>
      function carouselScroll(trackId, direction) {
        const track = document.getElementById(trackId);
        const slideWidth = track.offsetWidth;
        track.scrollBy({ left: direction * slideWidth, behavior: 'smooth' });
        // Update dots after scroll settles
        setTimeout(() => {
          const index = Math.round(track.scrollLeft / slideWidth);
          const carousel = track.closest('[id$="-carousel"]') || track.closest('.' + track.id.replace('-track', ''));
          const dotsId = trackId.replace('-track', '-dots');
          const dots = document.querySelectorAll('#' + dotsId + ' li');
          dots.forEach((d, i) => d.classList.toggle('active', i === index));
        }, 350);
      }
    </script>

    <!-- 3. Accordion -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Accordion</h2></div>
      <div class="component-preview">
        <details>
          <summary>Accordion Title 1</summary>
          <p>Here is the hidden content that is now revealed natively by the browser.</p>
        </details>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;details&gt;
  &lt;summary&gt;Accordion Title 1&lt;/summary&gt;
  &lt;p&gt;Here is the hidden content that is now revealed natively by the browser.&lt;/p&gt;
&lt;/details&gt;</code></pre>
      </div>
    </section>

    <!-- 4. Card -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Card</h2></div>
      <div class="component-preview">
        <article class="<%= @prefix %>-card" style="max-width: 400px;">
          <header>Card Title</header>
          <div class="card-body">This is the main body of the card, populated with standard readable text.</div>
          <footer><button class="<%= @prefix %>-btn-primary">Action</button></footer>
        </article>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;article class="<%= @prefix %>-card"&gt;
  &lt;header&gt;Card Title&lt;/header&gt;
  &lt;div class="card-body"&gt;Content...&lt;/div&gt;
  &lt;footer&gt;&lt;button class="<%= @prefix %>-btn-primary"&gt;Action&lt;/button&gt;&lt;/footer&gt;
&lt;/article&gt;</code></pre>
      </div>
    </section>

    <!-- 4a-d. Card Variants -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Card Variants</h2></div>
      <div class="component-preview" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">

        <article class="<%= @prefix %>-card-primary">
