        </div>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;div class="<%= @prefix %>-dropdown" data-controller="dropdown"&gt;
  &lt;button class="<%= @prefix %>-btn-outline" data-action="click-&gt;dropdown#toggle"&gt;Actions ▼&lt;/button&gt;
  &lt;ul&gt;
    &lt;li&gt;Edit Profile&lt;/li&gt;
    &lt;li&gt;Settings&lt;/li&gt;
  &lt;/ul&gt;
&lt;/div&gt;</code></pre>
      </div>
    </section>

    <!-- 6. Group -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Group</h2></div>
      <div class="component-preview">
        <div class="<%= @prefix %>-group">
          <input type="text" placeholder="Search..." style="border: 1px solid #d1d5db; padding: 0.5rem;" />
          <button class="<%= @prefix %>-btn-primary">Submit</button>
        </div>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;div class="<%= @prefix %>-group"&gt;
  &lt;input type="text" placeholder="Search..." /&gt;
  &lt;button class="<%= @prefix %>-btn-primary"&gt;Submit&lt;/button&gt;
&lt;/div&gt;</code></pre>
      </div>
    </section>

    <!-- 7. Loading -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Loading</h2></div>
      <div class="component-preview">
        <span class="<%= @prefix %>-loader"></span>
      </div>
      <div class="component-code">
        <button class="copy-btn" data-action="clipboard#copy">Copy</button>
        <pre><code data-clipboard-target="source">&lt;span class="<%= @prefix %>-loader"&gt;&lt;/span&gt;</code></pre>
      </div>
    </section>

    <!-- 8. Modal -->
    <section class="component-section" data-controller="clipboard">
      <div class="component-header"><h2>Modal</h2></div>
      <div class="component-preview">
        <button class="<%= @prefix %>-btn-outline" onclick="document.getElementById('demo-modal').showModal()">Open Modal</button>
