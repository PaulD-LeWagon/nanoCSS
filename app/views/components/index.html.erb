&lt;button class="<%= @prefix %>-btn-secondary"&gt;Secondary&lt;/button&gt;
&lt;button class="<%= @prefix %>-btn-outline"&gt;Outline&lt;/button&gt;</code></pre>
      </div>
    </section>

    <!-- 13. Badges -->
